# Set your canonical production URL in Vercel before building.
# If unset, Vercel's production project URL is used; locally, localhost:3000.
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Use a restricted Stripe key with only Checkout Session permissions. Never commit real keys.
STRIPE_SECRET_KEY=
# Stripe Dashboard → Developers → Webhooks → signing secret for /api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Private author portal at /post. Set these in Vercel; never commit their values.
AUTHOR_EMAIL=
AUTHOR_PASSWORD=
# A long random value used to sign the author session cookie.
AUTHOR_SESSION_SECRET=
# GitHub fine-grained token with Contents read/write access for this repository.
GITHUB_TOKEN=
# Optional; these default to JaredLederman1/takebackamerica and main.
GITHUB_REPOSITORY=JaredLederman1/takebackamerica
GITHUB_BRANCH=main
